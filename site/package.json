{
  "name": "airgrip-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "convert": "python3 tools/convert.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && python3 ../design/tools/check_launch.py dist && node scripts/check-dist.mjs",
    "preview": "vite preview --outDir dist --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
